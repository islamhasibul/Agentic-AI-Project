# Proofly — environment variables (template)
#
# Copy this file to .env.local and fill in real values. NEVER commit
# .env.local — it is already in .gitignore. Supabase credentials are
# sensitive: do not paste them into PRs, issues, or screenshots.
#
# Until Supabase env vars are set, the app runs in DEMO MODE: the existing
# in-memory store and the fake auth form keep working. The moment all
# required variables are present, the real Supabase code path takes over
# (without any code edits being required).

# ─── App ────────────────────────────────────────────────────────────────────
# Base URL the app runs at. Used to build absolute URLs for auth
# redirects and OpenGraph meta tags. In dev this is almost always
# http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ───────────────────────────────────────────────────────────────
# To fill in:
#   1. Create a project at https://supabase.com (free tier is enough).
#   2. Project Settings → API.
#   3. Copy the URL and the two keys below.

# The Project URL — looks like https://<project-ref>.supabase.co.
# This value is inlined into the browser bundle so the client Supabase
# SDK can reach the API. It is not secret on its own (it is also visible
# in the address bar of every Supabase request).
NEXT_PUBLIC_SUPABASE_URL=

# The `anon` (a.k.a. `public`) API key.
# Safe for the browser: it is RLS-bound and only allows what the row's
# policies permit. Treat it as a publishable identifier, not a secret —
# but still do not commit it to git.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The `service_role` (a.k.a. `secret`) API key.
# SERVER-ONLY. Bypasses RLS. Never, ever expose this to a browser bundle.
# It is imported only by lib/supabase/admin.ts, which has a runtime guard
# that throws if loaded in a browser context and uses Next's "server-only"
# marker so the bundler refuses any client import. Required only by trusted
# server scripts (webhook receivers, admin jobs); for the regular
# request/response cycle, the anon client (lib/supabase/server.ts) is
# preferred because RLS continues to enforce tenant isolation.
SUPABASE_SERVICE_ROLE_KEY=